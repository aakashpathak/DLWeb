# Claude does brand tone, image analysis and the storyboard. Without it the app
# falls back to on-device heuristics (still produces a reel, with plainer copy).
ANTHROPIC_API_KEY=
# Model for analysis + storyboard (Sonnet-class per the spec).
PRODUCTCLIPS_MODEL=claude-sonnet-5-5
# Single-user password gate. Leave empty to disable (local only).
APP_PASSWORD=
# Optional overrides
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
# DATA_DIR=.data

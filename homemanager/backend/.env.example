# Password the app uses to talk to this server. Pick anything long; type the same into the app.
HM_TOKEN=

# Optional: paste a Ring refresh token here instead of signing in from the app
# (get one with: npm run ring-token). The app's "Link Ring account" does the same thing.
RING_REFRESH_TOKEN=

# Optional: makes "Ask Home Manager" answer properly. Without it you get a basic summary.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: iPhone push for events that need attention (see README, "Push notifications").
APNS_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=fyi.vaak.homemanager
# TestFlight and App Store builds use production. Set false only for builds run from Xcode.
APNS_PRODUCTION=true

# Seconds a person may be at the door before Home Manager decides (a courier drops and leaves).
HOLD_SECONDS=30
PORT=8788

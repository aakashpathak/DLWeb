# Copy this file to .env and fill in what you use. Lines starting with # are ignored.

# Which brain plans: "claude" (Anthropic API) or "ollama" (a model running on this computer).
PROVIDER=claude

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5 is the cost-efficient default (~0.7¢ per plan). claude-opus-5 is smarter and ~3x the price.
CLAUDE_MODEL=claude-sonnet-5
# low | medium | high — medium is a good balance of speed and quality for planning
CLAUDE_EFFORT=medium

# --- Ollama (local model) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# A password the app must send. Pick anything; paste the same thing in Runway → Settings → Server password.
# Leave empty to allow anyone who finds the URL (fine for a quick test, not for real use).
RUNWAY_TOKEN=

# Port to listen on.
PORT=8787

# Origins allowed to call this server (comma-separated). "*" allows all.
ALLOWED_ORIGINS=https://aakashpathak.github.io,http://localhost:8000,http://127.0.0.1:8765,capacitor://localhost,http://localhost
